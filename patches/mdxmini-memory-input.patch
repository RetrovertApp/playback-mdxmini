+int mdx_open( t_mdxmini *data, char *filename , char *pcmdir )
+{
+  MDX_DATA *mdx = mdx_open_mdx( filename );
+  PDX_DATA *pdx;
+
+  if ( !mdx )
+    return -1;
+
+  if ( pcmdir )
+    strcpy(mdx->pdx_dir , pcmdir );
+
+  pdx = _get_pdx( mdx, filename );
+  return mdx_open_parsed(data, mdx, pdx);
+}
+
+int mdx_open_memory( t_mdxmini *data, const unsigned char *mdx_data, long mdx_length,
+                     const unsigned char *pdx_data, long pdx_length )
+{
+  MDX_DATA *mdx = mdx_open_mdx_data(mdx_data, mdx_length);
+  PDX_DATA *pdx = NULL;
+
+  if ( !mdx )
+    return -1;
+
+  if ( pdx_data && pdx_length > 0 )
+    pdx = mdx_open_pdx((unsigned char *)pdx_data, pdx_length);
+
+  mdx->pdx_enable = FLAG_TRUE;
+  if ( !pdx )
+    mdx->haspdx = FLAG_FALSE;
+
+  return mdx_open_parsed(data, mdx, pdx);
+}
