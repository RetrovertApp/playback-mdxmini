+MDX_DATA *mdx_open_mdx_data( const unsigned char *data, long length ) {
+  MDX_DATA *mdx;
+
+  if ( data == NULL || length <= 0 ) return NULL;
+
+  mdx = __alloc_mdxwork();
+  if ( mdx == NULL ) return NULL;
+
+  mdx->data = (unsigned char *)malloc((size_t)length + 16);
+  if ( mdx->data == NULL ) {
+    free(mdx);
+    return NULL;
+  }
+
+  memcpy(mdx->data, data, (size_t)length);
+  memset(mdx->data + length, 0, 16);
+  mdx->length = length;
+
+  return __parse_mdx(mdx);
+}
